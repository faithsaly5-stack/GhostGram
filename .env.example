API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
PHONE_NUMBER=YOUR_PHONE_NUMBER_WITH_COUNTRY_CODE

GEMINI_API_KEYS=YOUR_GEMINI_KEY
MODEL_NAME=gemini-3.5-flash-lite

# 🧠 Gemini Models Cascade Configuration
# Format: model_name:rpm:rpd,model_name2:rpm:rpd
# To disable a model, simply remove it from this comma-separated list!
GEMINI_MODELS="gemini-3.6-flash:5:20,gemini-3.5-flash:5:20,gemini-3.0-flash:5:20,gemini-2.5-flash:5:20,gemini-3.5-flash-lite:15:500,gemini-3.1-flash-lite:15:500,gemini-2.5-flash-lite:10:20"

SESSION_NAME=teleagent_session
# SESSION_STRING= (Optional, generated by python login.py for 100% cloud deployments like Railway/Render)

# Owner Profile & Persona Settings
OWNER_ID=YOUR_TELEGRAM_USER_ID
OWNER_NAME=YourName
OWNER_BIO=Student & Developer / دانشجو و برنامه‌نویس
OWNER_WEBSITE=yourwebsite.com
OWNER_SERVICES=Consulting, Web Design, AI Bots / مشاوره و برنامه‌نویسی
OWNER_INTERESTS=Music, Tech, Literature / موسیقی، تکنولوژی و کتاب

# Deployment Settings
VPS_IP=YOUR_VPS_IP
SSH_USER=root
SSH_PORT=22